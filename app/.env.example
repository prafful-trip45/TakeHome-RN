# SWAG RN app — environment template. Copy to .env (gitignored) and fill in.
# EXPO_PUBLIC_* values are baked into the JS bundle at build/update time — they
# are client-visible by design; nothing here is a server secret.

# Deployed admin panel (push registry, version gate, opened-events).
EXPO_PUBLIC_API_BASE_URL=https://swag-rn-assignment.vercel.app

# Task 10 — Sentry. DSN is env-supplied, never committed (spec requirement).
# Leave empty to run with Sentry disabled.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source-map upload (EAS build time only — set these on EAS, not locally):
#   SENTRY_ORG          — org slug        (plain env var)
#   SENTRY_PROJECT      — project slug    (plain env var)
#   SENTRY_AUTH_TOKEN   — auth token      (EAS secret / sensitive)
SENTRY_ORG=
SENTRY_PROJECT=

# Task 10 — Firebase. NOT env vars: place the credential files at
#   app/src/firebase/google-services.json        (Android — also enables FCM push)
#   app/src/firebase/GoogleService-Info.plist    (iOS)
# (both gitignored). On EAS, provide them as FILE-type env vars instead:
#   GOOGLE_SERVICES_JSON / GOOGLE_SERVICE_INFO_PLIST (paths override the defaults).
# app.config.ts auto-activates the Firebase plugins when the files exist.

# Optional override for the EAS Update endpoint (defaults to the project id).
# EXPO_PUBLIC_UPDATES_URL=
