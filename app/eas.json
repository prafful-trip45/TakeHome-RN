{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "preview",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://take-home-rn.vercel.app",
        "EXPO_PUBLIC_APP_LINK_HOST": "take-home-rn.vercel.app"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://take-home-rn.vercel.app",
        "EXPO_PUBLIC_APP_LINK_HOST": "take-home-rn.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
